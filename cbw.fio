[global]
name=rampup
time_based=1
runtime=10m
ioengine=rbd
pool=rbd
direct=1
verify=0
iodepth=8
rw=randrw
rwmixwrite=50
rate=25600k,25600k
random_distribution=zoned:50/5:30/15:20/80
bs=16k
percentile_list=95.0:95.33:95.66:96.0:96.33:96.66:97.0:97.33:97.66:98.0:98.33:98.66:99.0:99.33:99.66:99.99
cpus_allowed=10-23
cpus_allowed_policy=split
group_reporting=1
numjobs=1

[job1]
rbdname=test1

[job2]
rbdname=test2

[job3]
rbdname=test3

[job4]
rbdname=test4

[job5]
rbdname=test5

[job6]
rbdname=test6

[job7]
rbdname=test7

[job8]
rbdname=test8

