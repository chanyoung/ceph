[global]
name=prefill
ioengine=rbd
pool=rbd
direct=1
verify=0
iodepth=32
rw=write
bs=128k
cpus_allowed=10-23
cpus_allowed_policy=split
group_reporting=1
numjobs=1

[job1]
rbdname=test1

[job2]
rbdname=test2

[job3]
rbdname=test3

[job4]
rbdname=test4

[job5]
rbdname=test5

[job6]
rbdname=test6

[job7]
rbdname=test7

[job8]
rbdname=test8

